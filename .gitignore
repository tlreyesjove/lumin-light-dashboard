# Python
.venv/
__pycache__/
*.pyc

# Google service account credentials — never commit these
credentials/*.json
.env

# Generated data files (regenerate with scripts/generate_data.py — Google Sheets is the source of truth)
data/*.csv

# Real Be Girl files — reference material only, must NEVER be committed
# (this repo is meant to go public). Only the Lumin Light version we build
# from this template belongs in git.
Be Girl*.xlsx

# Excel lock files (created while any .xlsx in this repo is open)
~$*.xlsx

# OS junk
.DS_Store
