# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is gitignored — it never gets committed, since GOOGLE_SHEET_ID
# points at your personal Google Sheet.

# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Path to the service account key JSON file you'll download from Google
# Cloud Console. Keep it inside credentials/ — that folder is gitignored.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
